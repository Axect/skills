#!/usr/bin/env python3
"""rmsync — mirror the reMarkable Cloud into a local directory and render PDFs.

Layout (MIRROR defaults to ~/Documents/Remarkable, override with RM_MIRROR):

    <MIRROR>/raw/<tree>/<name>.rmdoc   downloaded archives
    <MIRROR>/pdf/<tree>/<name>.pdf     rendered by ./rmrender
    <MIRROR>/.state.json               id -> {path, modifiedClient}

Everything is addressed by document ID, never by path:

- The whole tree comes from one `rmapi -json find /` call, and paths are rebuilt
  locally from the `parent` pointers. Walking folder by folder with `ls` instead
  loses every subtree whose folder name is ambiguous, and makes hundreds of
  token requests, which the cloud starts refusing.
- Documents are fetched with `rmapi get --id <id>`, so names containing "/" and
  siblings sharing a name - neither addressable by path - work like any other.

Incremental: a document is re-downloaded only when its cloud `modifiedClient`
differs from the recorded one. Archives are kept, so an interrupted run is
resumed by re-rendering locally rather than re-downloading.

Documents that disappeared from the cloud have their mirror files removed. The
trash collection is skipped.

Environment: RM_MIRROR, RMAPI (rmapi binary, default `rmapi` on PATH),
RM_SKIP_DIRS (comma-separated folder names to skip, default `trash`).
"""
import json
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path

BASE = Path(os.environ.get("RM_MIRROR", Path.home() / "Documents/Remarkable")).expanduser()
RAW, PDF = BASE / "raw", BASE / "pdf"
STATE = BASE / ".state.json"
RMAPI = os.environ.get("RMAPI", "rmapi")
RMRENDER = str(Path(__file__).resolve().parent / "rmrender")
SKIP_DIRS = {
    d.strip().lower()
    for d in os.environ.get("RM_SKIP_DIRS", "trash").split(",")
    if d.strip()
}


def rmapi(*args, retries=3, **kw):
    """Run rmapi, retrying transient cloud-auth failures.

    rmapi refreshes its user token on every invocation, so a large run makes
    many token requests and the service starts answering `failed to create
    user token from device token request`. Backing off clears it."""
    detail = ""
    for attempt in range(retries):
        r = subprocess.run([RMAPI, *args], capture_output=True, text=True, **kw)
        if r.returncode == 0:
            return r.stdout
        detail = r.stderr.strip()[:200] or r.stdout.strip()[:200]
        if "token" not in detail or attempt == retries - 1:
            break
        time.sleep(2 * 2**attempt)
    raise RuntimeError(f"{RMAPI} {' '.join(args)}: {detail}")


def cloud_documents():
    """Yield (entry, local_relative_path) for every live document."""
    entries = json.loads(rmapi("-json", "find", "/"))
    by_id = {e["id"]: e for e in entries}

    def ancestry(entry):
        """Entry plus its ancestor folders, innermost first."""
        chain, cur, seen = [], entry, set()
        while cur is not None and cur["id"] and cur["id"] not in seen:
            seen.add(cur["id"])
            chain.append(cur)
            cur = by_id.get(cur["parent"])
        return chain

    used = {}
    # sorted by id: the document that keeps the unsuffixed path must not change
    # from run to run, otherwise the mirror renames files on every sync
    for e in sorted(entries, key=lambda x: x["id"]):
        if e["type"] != "DocumentType":
            continue
        chain = ancestry(e)
        if any(node["name"].lower() in SKIP_DIRS for node in chain[1:]):
            continue
        # a document name may contain "/", which must not become a directory
        parts = [node["name"].replace("/", "_") for node in reversed(chain)]
        rpath = "/".join(parts)
        # two documents may share a name inside one folder, which would make
        # them overwrite each other locally; keep both by adding an id suffix
        if used.setdefault(rpath, e["id"]) != e["id"]:
            rpath = f"{rpath} ({e['id'][:8]})"
        yield e, rpath


def download(entry, raw_f):
    """Fetch a document by id and move it to raw_f.

    rmapi names its output after the document's visible name, so the fetch runs
    in a scratch directory: otherwise a name containing "/" fails on the missing
    directories, and two documents sharing a name overwrite each other's
    archive before we can rename them apart."""
    with tempfile.TemporaryDirectory(dir=raw_f.parent) as tmp:
        tmpdir = Path(tmp)
        written = tmpdir / f"{entry['name']}.rmdoc"
        written.parent.mkdir(parents=True, exist_ok=True)
        rmapi("get", "--id", entry["id"], cwd=tmpdir, timeout=900)
        if not written.exists():
            raise RuntimeError(f"no archive at {written.name}")
        written.replace(raw_f)


def main():
    RAW.mkdir(parents=True, exist_ok=True)
    PDF.mkdir(parents=True, exist_ok=True)
    state = json.loads(STATE.read_text()) if STATE.exists() else {}
    newstate = {}
    stats = {"downloaded": 0, "rendered": 0, "skipped": 0, "epub": 0, "failed": 0, "deleted": 0}

    for e, rpath in cloud_documents():
        eid = e["id"]
        newstate[eid] = {"path": rpath, "modifiedClient": e["modifiedClient"]}
        raw_f, pdf_f = RAW / f"{rpath}.rmdoc", PDF / f"{rpath}.pdf"

        unchanged = (
            eid in state
            and state[eid].get("modifiedClient") == e["modifiedClient"]
            and raw_f.exists()
        )
        # interrupted previous run: state entry lost, both artifacts on disk
        if (
            not unchanged
            and eid not in state
            and raw_f.exists()
            and pdf_f.exists()
            and pdf_f.stat().st_size > 0
        ):
            unchanged = True
        if unchanged:
            stats["skipped"] += 1
            continue

        # download when there is no local archive, or the state says the cloud
        # copy changed; if the state was lost, trust the local archive once
        need_download = not raw_f.exists() or eid in state

        raw_f.parent.mkdir(parents=True, exist_ok=True)
        pdf_f.parent.mkdir(parents=True, exist_ok=True)
        if need_download:
            try:
                download(e, raw_f)
            except (RuntimeError, subprocess.TimeoutExpired) as err:
                print(f"FAIL download {rpath}: {str(err)[:160]}")
                stats["failed"] += 1
                continue
            stats["downloaded"] += 1

        if (
            pdf_f.exists()
            and pdf_f.stat().st_size > 0
            and pdf_f.stat().st_mtime >= raw_f.stat().st_mtime
        ):
            continue  # rendered output already current

        r = subprocess.run(
            [RMRENDER, str(raw_f), str(pdf_f)], capture_output=True, text=True, timeout=900
        )
        if r.returncode == 0:
            stats["rendered"] += 1
        elif r.returncode == 2:
            stats["epub"] += 1
            pdf_f.unlink(missing_ok=True)
        else:
            last = (r.stderr.strip().splitlines() or ["?"])[-1]
            print(f"FAIL render {rpath}: {last[:160]}")
            stats["failed"] += 1

    # Remove mirror files that no live document claims: documents deleted in the
    # cloud, and paths left behind when a document was renamed or re-suffixed.
    # Safe because the tree arrived in one call, so `newstate` is complete.
    live = {v["path"] for v in newstate.values()}
    for root, ext in ((RAW, ".rmdoc"), (PDF, ".pdf")):
        for f in root.rglob(f"*{ext}"):
            if str(f.relative_to(root))[: -len(ext)] not in live:
                f.unlink()
                stats["deleted"] += 1
    for root in (RAW, PDF):
        for d in sorted(root.rglob("*"), key=lambda x: -len(x.parts)):
            if d.is_dir() and not any(d.iterdir()):
                d.rmdir()

    STATE.write_text(json.dumps(newstate, indent=1, ensure_ascii=False))
    print(json.dumps(stats))
    return 1 if stats["failed"] else 0


if __name__ == "__main__":
    sys.exit(main())
