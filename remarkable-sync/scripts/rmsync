#!/usr/bin/env python3
"""rmsync — mirror the reMarkable Cloud into a local directory and render PDFs.

Layout (MIRROR defaults to ~/Documents/Remarkable, override with RM_MIRROR):

    <MIRROR>/raw/<tree>/<name>.rmdoc   downloaded archives
    <MIRROR>/pdf/<tree>/<name>.pdf     rendered by ./rmrender
    <MIRROR>/.state.json               id -> {path, modifiedClient}

Incremental: a document is re-downloaded only when its cloud `modifiedClient`
differs from the recorded one. Re-running after an interrupted run costs no
bandwidth, because existing archives are kept and only re-rendered.

`rmapi get` cannot fetch a directory, so the tree is walked with
`rmapi -json ls` and every document fetched individually. Folder listings do
fail occasionally; such a subtree is reported and skipped instead of aborting
the whole run.

The trash collection is skipped. Documents that disappeared from the cloud have
their mirror entries removed - but only when every listing succeeded, since a
failed listing looks exactly like an emptied folder.

Environment: RM_MIRROR, RMAPI (rmapi binary, default `rmapi` on PATH),
RM_SKIP_DIRS (comma-separated folder names to skip, default `trash`).
"""
import json
import os
import subprocess
import sys
import time
from collections import Counter
from pathlib import Path

BASE = Path(os.environ.get("RM_MIRROR", Path.home() / "Documents/Remarkable")).expanduser()
RAW, PDF = BASE / "raw", BASE / "pdf"
STATE = BASE / ".state.json"
RMAPI = os.environ.get("RMAPI", "rmapi")
RMRENDER = str(Path(__file__).resolve().parent / "rmrender")
SKIP_DIRS = {
    d.strip().lower()
    for d in os.environ.get("RM_SKIP_DIRS", "trash").split(",")
    if d.strip()
}


def rmapi(*args, retries=3, **kw):
    """Run rmapi, retrying transient cloud-auth failures.

    rmapi refreshes its user token per invocation, so a whole-tree walk makes
    hundreds of token requests and the service starts answering `failed to
    create user token from device token request`. Backing off clears it."""
    detail = ""
    for attempt in range(retries):
        r = subprocess.run([RMAPI, *args], capture_output=True, text=True, **kw)
        if r.returncode == 0:
            return r.stdout
        detail = r.stderr.strip()[:200] or r.stdout.strip()[:200]
        if "token" not in detail or attempt == retries - 1:
            break
        time.sleep(2 * 2**attempt)
    raise RuntimeError(f"{RMAPI} {' '.join(args)}: {detail}")


LIST_FAILURES = []
AMBIGUOUS = []


def walk(path="/", rel=""):
    """Yield (entry, local_relative_path, remote_path).

    The local path is sanitised (a document name may contain "/"), the remote
    path keeps the original names so `rmapi get` can resolve it."""
    try:
        entries = json.loads(rmapi("-json", "ls", path))
    except (RuntimeError, json.JSONDecodeError) as err:
        print(f"WARN cannot list {path}: {str(err)[:120]}")
        LIST_FAILURES.append(path)
        return
    # rmapi addresses entries by name, so two siblings sharing a name cannot be
    # resolved at all ("no matches for X" / "file doesn't exist"). Skip them.
    counts = Counter(e["name"] for e in entries)
    for e in entries:
        name = e["name"].replace("/", "_")
        rpath = f"{rel}/{name}" if rel else name
        remote = f"{path.rstrip('/')}/{e['name']}"
        if counts[e["name"]] > 1:
            if rpath not in AMBIGUOUS:
                AMBIGUOUS.append(rpath)
                print(f"SKIP ambiguous name (duplicate sibling): {rpath}")
            continue
        if e["type"] == "CollectionType":
            if name.lower() in SKIP_DIRS:
                continue
            yield from walk(remote, rpath)
        else:
            yield e, rpath, remote


def main():
    RAW.mkdir(parents=True, exist_ok=True)
    PDF.mkdir(parents=True, exist_ok=True)
    state = json.loads(STATE.read_text()) if STATE.exists() else {}
    newstate = {}
    stats = {"downloaded": 0, "rendered": 0, "skipped": 0, "epub": 0, "failed": 0, "unreachable": 0, "deleted": 0}

    for e, rpath, remote in walk():
        eid = e["id"]
        newstate[eid] = {"path": rpath, "modifiedClient": e["modifiedClient"]}
        raw_f, pdf_f = RAW / f"{rpath}.rmdoc", PDF / f"{rpath}.pdf"

        if "/" in e["name"] and not raw_f.exists():
            # rmapi addresses documents by path and has no escaping, so a name
            # containing "/" is unreachable; rename it on the tablet to fetch it
            print(f"SKIP unreachable name (contains '/'): {rpath}")
            stats["unreachable"] += 1
            continue

        unchanged = (
            eid in state
            and state[eid].get("modifiedClient") == e["modifiedClient"]
            and raw_f.exists()
        )
        # interrupted previous run: state entry lost, both artifacts on disk
        if (
            not unchanged
            and eid not in state
            and raw_f.exists()
            and pdf_f.exists()
            and pdf_f.stat().st_size > 0
        ):
            unchanged = True
        if unchanged:
            stats["skipped"] += 1
            continue

        # download when there is no local archive, or the state says the cloud
        # copy changed; if the state was lost, trust the local archive once
        need_download = not raw_f.exists() or eid in state

        raw_f.parent.mkdir(parents=True, exist_ok=True)
        pdf_f.parent.mkdir(parents=True, exist_ok=True)
        if need_download:
            try:
                rmapi("get", remote, cwd=raw_f.parent, timeout=600)
            except (RuntimeError, subprocess.TimeoutExpired) as err:
                print(f"FAIL download {remote}: {str(err)[:160]}")
                stats["failed"] += 1
                continue
            got = next(raw_f.parent.glob(f"{e['name']}*.rmdoc"), None)
            if got is None:
                print(f"FAIL download {remote}: no archive appeared")
                stats["failed"] += 1
                continue
            if got != raw_f:
                got.rename(raw_f)
            stats["downloaded"] += 1

        if (
            pdf_f.exists()
            and pdf_f.stat().st_size > 0
            and pdf_f.stat().st_mtime >= raw_f.stat().st_mtime
        ):
            continue  # rendered output already current

        r = subprocess.run(
            [RMRENDER, str(raw_f), str(pdf_f)], capture_output=True, text=True, timeout=900
        )
        if r.returncode == 0:
            stats["rendered"] += 1
        elif r.returncode == 2:
            stats["epub"] += 1
            pdf_f.unlink(missing_ok=True)
        else:
            last = (r.stderr.strip().splitlines() or ["?"])[-1]
            print(f"FAIL render {rpath}: {last[:160]}")
            stats["failed"] += 1

    # Never treat a document as deleted when part of the tree could not be
    # listed: a failed listing is indistinguishable from an emptied folder.
    if LIST_FAILURES:
        print(f"NOTE {len(LIST_FAILURES)} listing(s) failed; skipping deletion pass")
    else:
        protected = set(AMBIGUOUS)
        for eid, old in state.items():
            if eid not in newstate and old.get("path") not in protected:
                for f in (RAW / f"{old['path']}.rmdoc", PDF / f"{old['path']}.pdf"):
                    if f.exists():
                        f.unlink()
                        stats["deleted"] += 1

    STATE.write_text(json.dumps(newstate, indent=1, ensure_ascii=False))
    stats["unreachable"] += len(AMBIGUOUS)
    print(json.dumps(stats))
    return 0


if __name__ == "__main__":
    sys.exit(main())
